railroad-ebnf-beta

    /*****************************************************************************
    *  17. DATA STATEMENT                                                       *
    *****************************************************************************/
    %%/// `data_statement` grammar rule.
    %%///
    data_statement = {space}, "DATA", {space}, data_list;

    %%/// `data_list` grammar rule.
    %%///
    data_list = datum, {comma, datum};
